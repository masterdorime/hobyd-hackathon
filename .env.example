# .env.example — copy to .env.local, isi nilainya, JANGAN commit .env.local
# Sumber nilai-nilai ini ada di docs/02-data-model-and-env.md

# Supabase (Postgres + Auth + Realtime + Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit Cloud (video saja — TIDAK membawa state bid)
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Midtrans sandbox (QRIS; tidak ada charge asli)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Aturan lelang (boleh diubah tanpa ubah kode)
SELLER_ALLOWLIST=
MAX_SNIPING_EXTENSIONS=5
EXTENSION_WINDOW_SEC=10
EXTENSION_ADD_SEC=10
AUCTION_DURATION_SEC=120
PAYMENT_WINDOW_SEC=300
